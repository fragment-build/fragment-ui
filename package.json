{
  "name": "@fragment-build/ui",
  "version": "3.2.0",
  "type": "module",
  "packageManager": "pnpm@11.15.0",
  "engines": {
    "node": ">=22"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "style": "index.css",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fragment-build/fragment-ui.git"
  },
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsc && rsync -a --prune-empty-dirs --include='*/' --include='*.css' --exclude='*' src/ dist/",
    "build:prod": "tsc --outDir . && rsync -a --prune-empty-dirs --include='*/' --include='*.css' --exclude='*' src/ .",
    "lint": "eslint --report-unused-disable-directives --max-warnings 0 ./src",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "update": "npx npm-check-updates -i --format group -p pnpm"
  },
  "peerDependencies": {
    "@heroui/react": ">=3.0.0",
    "@heroui/styles": ">=3.0.0",
    "@teispace/next-themes": ">=0.5.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "tailwindcss": ">=4.0.0"
  },
  "dependencies": {
    "@tabler/icons-react": "3.45.0",
    "apexcharts": "6.1.0",
    "react-apexcharts": "2.1.1",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@heroui/react": "3.2.2",
    "@heroui/styles": "3.2.2",
    "@teispace/next-themes": "2.0.4",
    "@storybook/addon-a11y": "10.5.2",
    "@storybook/addon-docs": "10.5.2",
    "@storybook/addon-links": "10.5.2",
    "@storybook/react-vite": "10.5.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.64.0",
    "@typescript-eslint/parser": "8.64.0",
    "@vitejs/plugin-react": "6.0.3",
    "@vitejs/plugin-react-swc": "4.3.1",
    "@vueless/storybook-dark-mode": "10.0.8",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "eslint-plugin-storybook": "10.5.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "storybook": "10.5.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vite": "8.1.5"
  }
}
